# ─────────────────────────────────────────────────────────────────────────────
#  ENVIRONMENT CONFIGURATION  —  copy this file to ".env" and fill in your key.
#
#  Quick start:
#     cp .env.example .env
#     then paste your OpenWeatherMap key into OPENWEATHER_API_KEY below.
#
#  See the "How to swap the API key" section of README.md for a click-by-click
#  walkthrough (written for people who have never set up an API key before).
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — your free OpenWeatherMap API key.
# Get one at https://home.openweathermap.org/api_keys  (free "Current Weather" plan).
# A brand-new key can take up to ~2 hours to activate, even if it shows "Active".
OPENWEATHER_API_KEY=your_api_key_here

# Port the HTTP server listens on.
PORT=3000

# Node environment: "development" | "production" | "test".
NODE_ENV=development

# OpenWeatherMap base URL — you should not need to change this.
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# How often to refresh the cache, as a cron expression. Default = every 30 minutes.
WEATHER_REFRESH_CRON=*/30 * * * *

# Abort an OpenWeatherMap request if it takes longer than this (milliseconds).
REQUEST_TIMEOUT_MS=8000

# Rate limiting: max requests per IP within the window. Default = 30 per 60s.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
